# HFT Full Pipeline - System-Only Makefile
# Strategies have been moved to sabi-cppstrategies repo
# This Makefile builds ONLY the core HFT system components

SHELL := /bin/bash
CXX       ?= c++
CXXFLAGS  := -std=c++20 -Wall -Wextra -O2 -pthread

# Library prefixes with fallback paths
OPENSSL_PREFIX := $(shell brew --prefix openssl@3 2>/dev/null || echo /opt/homebrew/opt/openssl@3)
BOOST_PREFIX   := $(shell brew --prefix boost 2>/dev/null || echo /opt/homebrew/opt/boost)
JSON_PREFIX    := $(shell brew --prefix nlohmann-json 2>/dev/null || echo /opt/homebrew/opt/nlohmann-json)
ZMQ_PREFIX     := $(shell brew --prefix zeromq 2>/dev/null || echo /opt/homebrew/opt/zeromq)
CPPZMQ_PREFIX  := $(shell brew --prefix cppzmq 2>/dev/null || echo /opt/homebrew/opt/cppzmq)
PROTOBUF_PREFIX := $(shell brew --prefix protobuf 2>/dev/null || echo /opt/homebrew/opt/protobuf)
ABSEIL_PREFIX  := $(shell brew --prefix abseil 2>/dev/null || echo /opt/homebrew/opt/abseil)
WEBSOCKETPP_PREFIX := $(shell brew --prefix websocketpp 2>/dev/null || echo /opt/homebrew/opt/websocketpp)

INCLUDES := -I. -I$(BOOST_PREFIX)/include -I$(OPENSSL_PREFIX)/include -I$(JSON_PREFIX)/include \
            -I$(ZMQ_PREFIX)/include -I$(CPPZMQ_PREFIX)/include -I$(PROTOBUF_PREFIX)/include \
            -I$(ABSEIL_PREFIX)/include -I$(WEBSOCKETPP_PREFIX)/include

# Abseil libraries (required by protobuf)
ABSEIL_LIBS := -labsl_log_internal_check_op -labsl_log_internal_conditions \
               -labsl_log_internal_format -labsl_log_internal_globals \
               -labsl_log_internal_log_sink_set -labsl_log_internal_message \
               -labsl_log_severity -labsl_log_entry -labsl_log_globals \
               -labsl_hash -labsl_city -labsl_raw_hash_set -labsl_hashtablez_sampler \
               -labsl_exponential_biased \
               -labsl_strings -labsl_strings_internal -labsl_str_format_internal \
               -labsl_cord -labsl_cordz_info -labsl_cord_internal \
               -labsl_cordz_functions -labsl_cordz_handle \
               -labsl_crc_cord_state -labsl_crc32c -labsl_crc_internal -labsl_crc_cpu_detect \
               -labsl_synchronization -labsl_graphcycles_internal -labsl_kernel_timeout_internal \
               -labsl_time -labsl_civil_time -labsl_time_zone \
               -labsl_malloc_internal -labsl_base -labsl_spinlock_wait \
               -labsl_int128 -labsl_throw_delegate -labsl_stacktrace -labsl_symbolize \
               -labsl_debugging_internal -labsl_demangle_internal -labsl_raw_logging_internal

LIBS     := -L$(OPENSSL_PREFIX)/lib -L$(ZMQ_PREFIX)/lib -L$(PROTOBUF_PREFIX)/lib -L$(ABSEIL_PREFIX)/lib \
            -lssl -lcrypto -lpthread -lzmq -lprotobuf -lcurl $(ABSEIL_LIBS)

BUILDDIR := build
SRCDIRS  := discovery md net io core

COMMON_SRCS := $(foreach d,$(SRCDIRS),$(wildcard $(d)/*.cpp))
COMMON_OBJS := $(patsubst %.cpp,$(BUILDDIR)/%.o,$(COMMON_SRCS))

#==============================================================================
# SYSTEM BINARIES (Data pipeline, exchange connectors, market data)
#==============================================================================

# Data Recording and Replay
STREAM_MAIN    := run/stream_and_record.cpp
REPLAY_MAIN    := run/replay_and_book.cpp
SCAN_MAIN      := run/scan_recording.cpp
STREAM_LAT_MAIN := run/stream_with_latency.cpp

STREAM_BIN     := $(BUILDDIR)/stream_and_record
REPLAY_BIN     := $(BUILDDIR)/replay_and_book
SCAN_BIN       := $(BUILDDIR)/scan_recording
STREAM_LAT_BIN := $(BUILDDIR)/stream_with_latency

# Multi-Exchange Pipeline
MULTI_EXCHANGE_MAIN := run/complete_multi_exchange_pipeline.cpp
MULTI_EXCHANGE_BIN  := $(BUILDDIR)/complete_multi_exchange_pipeline

# Production HFT System with API
PRODUCTION_HFT_MAIN := run/production_hft_system.cpp
PRODUCTION_HFT_BIN  := $(BUILDDIR)/production_hft_system

# Integration Tests
TEST_HOT_COLD_MAIN := run/test_hot_cold_integration.cpp
TEST_HOT_COLD_BIN  := $(BUILDDIR)/test_hot_cold_integration

FULL_SYSTEM_MAIN := run/full_system_integration.cpp
FULL_SYSTEM_BIN  := $(BUILDDIR)/full_system_integration

# Dashboard Server
DASHBOARD_SERVER_MAIN := run/dashboard_server.cpp
DASHBOARD_SERVER_BIN  := $(BUILDDIR)/dashboard_server

# SQLite Backtest (uses historical data)
BACKTEST_SQLITE_MAIN := run/backtest_from_sqlite.cpp
BACKTEST_SQLITE_BIN  := $(BUILDDIR)/backtest_from_sqlite

# Backtest to JSON
BACKTEST_TO_JSON_MAIN := run/backtest_to_json.cpp
BACKTEST_TO_JSON_BIN  := $(BUILDDIR)/backtest_to_json

#==============================================================================
# TEST BINARIES (System tests only - strategy tests moved to sabi-cppstrategies)
#==============================================================================

# Lock-free Queue Tests
LOCKFREE_TEST_MAIN := test_scripts/test_lockfree_queues.cpp
LOCKFREE_TEST_BIN  := $(BUILDDIR)/test_lockfree_queues

# ZMQ Tests
ZMQ_PUBSUB_MAIN := test_scripts/test_zmq_pubsub.cpp
ZMQ_PUBSUB_BIN  := $(BUILDDIR)/test_zmq_pubsub

# Matching Engine Tests
MATCHING_SIMPLE_MAIN := test_scripts/test_matching_engine_simple.cpp
MATCHING_SIMPLE_BIN  := $(BUILDDIR)/test_matching_engine_simple

# Multi-Exchange Tests (system-level)
TEST_MULTI_EXCHANGE_FUNDING_MAIN := run/test_multi_exchange_funding.cpp
TEST_MULTI_EXCHANGE_FUNDING_BIN  := $(BUILDDIR)/test_multi_exchange_funding

# Integrated Pipeline Test
TEST_INTEGRATED_PIPELINE_MAIN := test_scripts/test_system_pipeline.cpp
TEST_INTEGRATED_PIPELINE_BIN  := $(BUILDDIR)/test_system_pipeline

#==============================================================================
# BUILD RULES
#==============================================================================

.PHONY: all clean system tests help

# Default: build all system components
all: system

# System components (no strategies)
system: $(STREAM_BIN) $(STREAM_LAT_BIN) $(REPLAY_BIN) $(SCAN_BIN) \
        $(MULTI_EXCHANGE_BIN) $(PRODUCTION_HFT_BIN) \
        $(TEST_HOT_COLD_BIN) $(FULL_SYSTEM_BIN) \
        $(DASHBOARD_SERVER_BIN) $(BACKTEST_SQLITE_BIN) $(BACKTEST_TO_JSON_BIN)

# System tests
tests: $(LOCKFREE_TEST_BIN) $(ZMQ_PUBSUB_BIN) $(MATCHING_SIMPLE_BIN) \
       $(TEST_MULTI_EXCHANGE_FUNDING_BIN) $(TEST_INTEGRATED_PIPELINE_BIN)

clean:
	rm -rf $(BUILDDIR)
	@echo "✓ Cleaned build directory"

# Generic compilation rules
$(BUILDDIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(BUILDDIR)/proto/%.pb.o: proto/%.pb.cc
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Data recording/replay binaries
$(STREAM_BIN): $(COMMON_OBJS) $(BUILDDIR)/run/stream_and_record.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS)
	@echo "✓ Built $@"

$(STREAM_LAT_BIN): $(COMMON_OBJS) $(BUILDDIR)/run/stream_with_latency.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS)
	@echo "✓ Built $@"

$(REPLAY_BIN): $(COMMON_OBJS) $(BUILDDIR)/run/replay_and_book.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS)
	@echo "✓ Built $@"

$(SCAN_BIN): $(BUILDDIR)/run/scan_recording.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^
	@echo "✓ Built $@"

# Multi-exchange pipeline
$(MULTI_EXCHANGE_BIN): $(COMMON_OBJS) $(BUILDDIR)/run/complete_multi_exchange_pipeline.o $(BUILDDIR)/proto/messages.pb.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS) -lsqlite3
	@echo "✓ Built $@"

# Production HFT system
$(PRODUCTION_HFT_BIN): $(COMMON_OBJS) $(BUILDDIR)/run/production_hft_system.o $(BUILDDIR)/proto/messages.pb.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS) -lsqlite3
	@echo "✓ Built $@"

# Integration tests
$(TEST_HOT_COLD_BIN): $(COMMON_OBJS) $(BUILDDIR)/run/test_hot_cold_integration.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS) -lsqlite3
	@echo "✓ Built $@"

$(FULL_SYSTEM_BIN): $(COMMON_OBJS) $(BUILDDIR)/run/full_system_integration.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS) -lsqlite3
	@echo "✓ Built $@"

# Dashboard
$(DASHBOARD_SERVER_BIN): $(COMMON_OBJS) $(BUILDDIR)/run/dashboard_server.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS) -lsqlite3
	@echo "✓ Built $@"

# SQLite backtest
$(BACKTEST_SQLITE_BIN): $(COMMON_OBJS) $(BUILDDIR)/run/backtest_from_sqlite.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS) -lsqlite3
	@echo "✓ Built $@"

# Backtest to JSON
$(BACKTEST_TO_JSON_BIN): $(COMMON_OBJS) $(BUILDDIR)/run/backtest_to_json.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS) -lsqlite3
	@echo "✓ Built $@"

# Test binaries
$(LOCKFREE_TEST_BIN): $(BUILDDIR)/test_scripts/test_lockfree_queues.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS)
	@echo "✓ Built $@"

$(ZMQ_PUBSUB_BIN): $(BUILDDIR)/test_scripts/test_zmq_pubsub.o $(BUILDDIR)/proto/messages.pb.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS)
	@echo "✓ Built $@"

$(MATCHING_SIMPLE_BIN): $(BUILDDIR)/test_scripts/test_matching_engine_simple.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS)
	@echo "✓ Built $@"

$(TEST_MULTI_EXCHANGE_FUNDING_BIN): $(COMMON_OBJS) $(BUILDDIR)/run/test_multi_exchange_funding.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS) -lsqlite3
	@echo "✓ Built $@"

$(TEST_INTEGRATED_PIPELINE_BIN): $(BUILDDIR)/test_scripts/test_system_pipeline.o
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS) -lsqlite3
	@echo "✓ Built $@"

#==============================================================================
# UTILITY TARGETS
#==============================================================================

.PHONY: stream replay scan multi_exchange production test_integration help

stream: $(STREAM_BIN)
replay: $(REPLAY_BIN)  
scan: $(SCAN_BIN)
multi_exchange: $(MULTI_EXCHANGE_BIN)
production: $(PRODUCTION_HFT_BIN)
test_integration: $(TEST_HOT_COLD_BIN) $(FULL_SYSTEM_BIN)

clean:
	rm -rf $(BUILDDIR)
	@echo "✓ Cleaned build directory"

help:
	@echo "HFT Full Pipeline - System Build Targets"
	@echo "========================================"
	@echo ""
	@echo "Main Targets:"
	@echo "  make system           - Build all system components"
	@echo "  make tests            - Build all system tests"
	@echo "  make all              - Build everything (default)"
	@echo ""
	@echo "Individual Components:"
	@echo "  make stream           - Build stream_and_record"
	@echo "  make replay           - Build replay_and_book"
	@echo "  make scan             - Build scan_recording"
	@echo "  make multi_exchange   - Build multi-exchange pipeline"
	@echo "  make production       - Build production HFT system"
	@echo ""
	@echo "Tests:"
	@echo "  make test_integration - Build integration tests"
	@echo ""
	@echo "Utilities:"
	@echo "  make clean            - Remove all build artifacts"
	@echo "  make help             - Show this help message"
	@echo ""
	@echo "Note: Strategy-related builds are in ../sabi-cppstrategies/"
