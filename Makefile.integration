#==============================================================================
# INTEGRATED STRATEGY-SYSTEM MAKEFILE
# Purpose: Build and test strategies from sabi-cppstrategies with HFT system
#==============================================================================

SHELL := /bin/bash
CXX       ?= c++
CXXFLAGS  := -std=c++20 -Wall -Wextra -O2 -pthread

# ============================================================================
# PATHS CONFIGURATION
# ============================================================================
STRATEGIES_REPO := ../sabi-cppstrategies
STRATEGIES_DIR  := $(STRATEGIES_REPO)/strats
SYSTEM_ROOT     := .
BUILDDIR        := build/integrated

# Check if strategies repo exists
ifeq (,$(wildcard $(STRATEGIES_REPO)))
    $(error Strategy repository not found at $(STRATEGIES_REPO). Please clone or set correct path.)
endif

# ============================================================================
# LIBRARY CONFIGURATION (from main Makefile)
# ============================================================================
OPENSSL_PREFIX := $(shell brew --prefix openssl@3 2>/dev/null || echo /opt/homebrew/opt/openssl@3)
BOOST_PREFIX   := $(shell brew --prefix boost 2>/dev/null || echo /opt/homebrew/opt/boost)
JSON_PREFIX    := $(shell brew --prefix nlohmann-json 2>/dev/null || echo /opt/homebrew/opt/nlohmann-json)
ZMQ_PREFIX     := $(shell brew --prefix zeromq 2>/dev/null || echo /opt/homebrew/opt/zeromq)
CPPZMQ_PREFIX  := $(shell brew --prefix cppzmq 2>/dev/null || echo /opt/homebrew/opt/cppzmq)
PROTOBUF_PREFIX := $(shell brew --prefix protobuf 2>/dev/null || echo /opt/homebrew/opt/protobuf)
ABSEIL_PREFIX  := $(shell brew --prefix abseil 2>/dev/null || echo /opt/homebrew/opt/abseil)
WEBSOCKETPP_PREFIX := $(shell brew --prefix websocketpp 2>/dev/null || echo /opt/homebrew/opt/websocketpp)

# ============================================================================
# INCLUDE PATHS
# ============================================================================
SYSTEM_INCLUDES := -I$(SYSTEM_ROOT) \
                   -I$(SYSTEM_ROOT)/arb \
                   -I$(SYSTEM_ROOT)/bt \
                   -I$(SYSTEM_ROOT)/core \
                   -I$(SYSTEM_ROOT)/pipeline \
                   -I$(SYSTEM_ROOT)/exchanges \
                   -I$(SYSTEM_ROOT)/md \
                   -I$(SYSTEM_ROOT)/io \
                   -I$(SYSTEM_ROOT)/storage

STRATEGY_INCLUDES := -I$(STRATEGIES_DIR)

LIB_INCLUDES := -I$(BOOST_PREFIX)/include \
                -I$(OPENSSL_PREFIX)/include \
                -I$(JSON_PREFIX)/include \
                -I$(ZMQ_PREFIX)/include \
                -I$(CPPZMQ_PREFIX)/include \
                -I$(PROTOBUF_PREFIX)/include \
                -I$(ABSEIL_PREFIX)/include \
                -I$(WEBSOCKETPP_PREFIX)/include

INCLUDES := $(SYSTEM_INCLUDES) $(STRATEGY_INCLUDES) $(LIB_INCLUDES)

# ============================================================================
# LIBRARY LINKS
# ============================================================================
ABSEIL_LIBS := -labsl_log_internal_check_op -labsl_log_internal_conditions \
               -labsl_log_internal_format -labsl_log_internal_globals \
               -labsl_log_internal_log_sink_set -labsl_log_internal_message \
               -labsl_log_severity -labsl_log_entry -labsl_log_globals \
               -labsl_hash -labsl_city -labsl_raw_hash_set -labsl_hashtablez_sampler \
               -labsl_exponential_biased \
               -labsl_strings -labsl_strings_internal -labsl_str_format_internal \
               -labsl_cord -labsl_cordz_info -labsl_cord_internal \
               -labsl_cordz_functions -labsl_cordz_handle \
               -labsl_crc_cord_state -labsl_crc32c -labsl_crc_internal -labsl_crc_cpu_detect \
               -labsl_synchronization -labsl_graphcycles_internal -labsl_kernel_timeout_internal \
               -labsl_time -labsl_civil_time -labsl_time_zone \
               -labsl_malloc_internal -labsl_base -labsl_spinlock_wait \
               -labsl_int128 -labsl_throw_delegate -labsl_stacktrace -labsl_symbolize \
               -labsl_debugging_internal -labsl_demangle_internal -labsl_raw_logging_internal

LIBS := -L$(OPENSSL_PREFIX)/lib \
        -L$(ZMQ_PREFIX)/lib \
        -L$(PROTOBUF_PREFIX)/lib \
        -L$(ABSEIL_PREFIX)/lib \
        -lssl -lcrypto -lpthread -lzmq -lprotobuf -lcurl -lsqlite3 $(ABSEIL_LIBS)

# ============================================================================
# TARGETS
# ============================================================================

.PHONY: all clean test_integration setup list_strategies help

all: setup test_integration

help:
	@echo "=================================================="
	@echo "  INTEGRATED STRATEGY-SYSTEM BUILD"
	@echo "=================================================="
	@echo ""
	@echo "Targets:"
	@echo "  make all               - Build all integration tests"
	@echo "  make test_integration  - Build strategy integration test"
	@echo "  make test_live         - Build live strategy test with market data"
	@echo "  make test_backtest     - Build backtest integration"
	@echo "  make list_strategies   - List available strategies"
	@echo "  make setup             - Create build directories"
	@echo "  make clean             - Remove build artifacts"
	@echo ""
	@echo "Paths:"
	@echo "  Strategies: $(STRATEGIES_DIR)"
	@echo "  System:     $(SYSTEM_ROOT)"
	@echo "  Build:      $(BUILDDIR)"
	@echo ""

setup:
	@mkdir -p $(BUILDDIR)
	@echo "✓ Build directory created: $(BUILDDIR)"

list_strategies:
	@echo "Available strategies in $(STRATEGIES_DIR):"
	@ls -1 $(STRATEGIES_DIR)/*.hpp | xargs -n1 basename | grep -v factory | grep -v live_strategy_engine || echo "No strategies found"

# ============================================================================
# INTEGRATION TEST: Test strategies with HFT system
# ============================================================================
test_integration: setup
	$(CXX) $(CXXFLAGS) $(INCLUDES) \
		test_scripts/test_integrated_strategies.cpp \
		-o $(BUILDDIR)/test_integrated_strategies \
		$(LIBS)
	@echo "✓ Built: $(BUILDDIR)/test_integrated_strategies"

# ============================================================================
# LIVE TEST: Run strategies with live market data from multi-exchange pipeline
# ============================================================================
test_live: setup
	$(CXX) $(CXXFLAGS) $(INCLUDES) \
		test_scripts/test_strategy_with_live_data.cpp \
		-o $(BUILDDIR)/test_strategy_with_live_data \
		$(LIBS)
	@echo "✓ Built: $(BUILDDIR)/test_strategy_with_live_data"

# ============================================================================
# BACKTEST: Run strategies on historical data
# ============================================================================
test_backtest: setup
	$(CXX) $(CXXFLAGS) $(INCLUDES) \
		test_scripts/test_strategy_backtest.cpp \
		-o $(BUILDDIR)/test_strategy_backtest \
		$(LIBS)
	@echo "✓ Built: $(BUILDDIR)/test_strategy_backtest"

# ============================================================================
# FULL DEMO: Complete integration demonstration
# ============================================================================
demo_full: setup
	$(CXX) $(CXXFLAGS) $(INCLUDES) \
		test_scripts/demo_strategy_integration.cpp \
		-o $(BUILDDIR)/demo_strategy_integration \
		$(LIBS)
	@echo "✓ Built: $(BUILDDIR)/demo_strategy_integration"

clean:
	rm -rf $(BUILDDIR)
	@echo "✓ Cleaned build directory"

# ============================================================================
# DIAGNOSTIC
# ============================================================================
check:
	@echo "Checking configuration..."
	@echo "Strategies repo: $(STRATEGIES_REPO)"
	@test -d $(STRATEGIES_REPO) && echo "  ✓ Found" || echo "  ✗ Not found"
	@echo "Strategies dir: $(STRATEGIES_DIR)"
	@test -d $(STRATEGIES_DIR) && echo "  ✓ Found" || echo "  ✗ Not found"
	@echo "Strategy count: $$(ls -1 $(STRATEGIES_DIR)/*.hpp 2>/dev/null | wc -l | xargs)"
	@echo "System root: $(SYSTEM_ROOT)"
	@test -d $(SYSTEM_ROOT)/arb && echo "  ✓ arb/ found" || echo "  ✗ arb/ not found"
	@test -d $(SYSTEM_ROOT)/bt && echo "  ✓ bt/ found" || echo "  ✗ bt/ not found"
