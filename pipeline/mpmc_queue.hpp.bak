// pipeline/mpmc_queue.hpp - Multi Producer Multi Consumer Lock-Free Queue
// Based on Dmitry Vyukov's bounded MPMC queue
#pragma once
#include <atomic>
#include <cstddef>
#include <new>

namespace pipeline {

using core::CACHE_LINE_SIZE;

/**
 * Lock-free MPMC (Multi Producer Multi Consumer) queue
 * - Wait-free for producers and consumers
 * - Based on Dmitry Vyukov's algorithm
 * - Cache-aligned cells to prevent false sharing
 * - Capacity must be power of 2
 * 
 * Usage: For scenarios with multiple threads producing/consuming market data
 */
template<typename T>
class MPMCQueue {
private:
    struct Cell {
        std::atomic<size_t> sequence;
        T data;
    };
    
public:
    explicit MPMCQueue(size_t capacity)
        : capacity_(round_up_to_power_of_2(capacity)),
          mask_(capacity_ - 1),
          buffer_(new Cell[capacity_]),
          enqueue_pos_(0),
          dequeue_pos_(0) {
        
        // Initialize sequence numbers
        for (size_t i = 0; i < capacity_; ++i) {
            buffer_[i].sequence.store(i, std::memory_order_relaxed);
        }
    }
    
    ~MPMCQueue() {
        delete[] buffer_;
    }
    
    // Non-copyable, non-movable
    MPMCQueue(const MPMCQueue&) = delete;
    MPMCQueue& operator=(const MPMCQueue&) = delete;
    
    /**
     * Try to enqueue an item (lock-free, multi-producer safe)
     */
    bool try_enqueue(const T& data) noexcept {
        Cell* cell;
        size_t pos = enqueue_pos_.load(std::memory_order_relaxed);
        
        for (;;) {
            cell = &buffer_[pos & mask_];
            size_t seq = cell->sequence.load(std::memory_order_acquire);
            intptr_t dif = (intptr_t)seq - (intptr_t)pos;
            
            if (dif == 0) {
                // Cell is ready for write
                if (enqueue_pos_.compare_exchange_weak(pos, pos + 1, 
                                                       std::memory_order_relaxed)) {
                    break;
                }
            } else if (dif < 0) {
                // Queue is full
                return false;
            } else {
                // Another thread got ahead, retry
                pos = enqueue_pos_.load(std::memory_order_relaxed);
            }
        }
        
        cell->data = data;
        cell->sequence.store(pos + 1, std::memory_order_release);
        return true;
    }
    
    /**
     * Try to enqueue with move semantics
     */
    bool try_enqueue(T&& data) noexcept {
        Cell* cell;
        size_t pos = enqueue_pos_.load(std::memory_order_relaxed);
        
        for (;;) {
            cell = &buffer_[pos & mask_];
            size_t seq = cell->sequence.load(std::memory_order_acquire);
            intptr_t dif = (intptr_t)seq - (intptr_t)pos;
            
            if (dif == 0) {
                if (enqueue_pos_.compare_exchange_weak(pos, pos + 1, 
                                                       std::memory_order_relaxed)) {
                    break;
                }
            } else if (dif < 0) {
                return false;
            } else {
                pos = enqueue_pos_.load(std::memory_order_relaxed);
            }
        }
        
        cell->data = std::move(data);
        cell->sequence.store(pos + 1, std::memory_order_release);
        return true;
    }
    
    /**
     * Try to dequeue an item (lock-free, multi-consumer safe)
     */
    bool try_dequeue(T& data) noexcept {
        Cell* cell;
        size_t pos = dequeue_pos_.load(std::memory_order_relaxed);
        
        for (;;) {
            cell = &buffer_[pos & mask_];
            size_t seq = cell->sequence.load(std::memory_order_acquire);
            intptr_t dif = (intptr_t)seq - (intptr_t)(pos + 1);
            
            if (dif == 0) {
                // Cell is ready for read
                if (dequeue_pos_.compare_exchange_weak(pos, pos + 1, 
                                                       std::memory_order_relaxed)) {
                    break;
                }
            } else if (dif < 0) {
                // Queue is empty
                return false;
            } else {
                // Another thread got ahead, retry
                pos = dequeue_pos_.load(std::memory_order_relaxed);
            }
        }
        
        data = std::move(cell->data);
        cell->sequence.store(pos + mask_ + 1, std::memory_order_release);
        return true;
    }
    
    /**
     * Approximate size (may be stale)
     */
    size_t size() const noexcept {
        size_t enq = enqueue_pos_.load(std::memory_order_acquire);
        size_t deq = dequeue_pos_.load(std::memory_order_acquire);
        return enq - deq;
    }
    
    size_t capacity() const noexcept {
        return capacity_;
    }

private:
    static size_t round_up_to_power_of_2(size_t n) noexcept {
        if (n == 0) return 1;
        n--;
        n |= n >> 1;
        n |= n >> 2;
        n |= n >> 4;
        n |= n >> 8;
        n |= n >> 16;
        n |= n >> 32;
        return n + 1;
    }
    
    const size_t capacity_;
    const size_t mask_;
    
    Cell* buffer_;
    
    // Separate cache lines to prevent false sharing
    alignas(CACHE_LINE_SIZE) std::atomic<size_t> enqueue_pos_;
    alignas(CACHE_LINE_SIZE) std::atomic<size_t> dequeue_pos_;
};

} // namespace pipeline
