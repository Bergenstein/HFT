        return symbol;
    }
    
    static std::string bybit_to_normalized(const std::string& symbol) {
        // BTCUSDT -> BTC-USDT
        std::string upper = symbol;
        std::transform(upper.begin(), upper.end(), upper.begin(), ::toupper);
        
